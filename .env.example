# ============================================================
# CODE NOIR — ENVIRONMENT CONFIGURATION
# ============================================================

# Database URL (SQLite default)
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------
# AI PROVIDER CONFIGURATION (Groq & Google Gemini)
# ------------------------------------------------------------

# Primary AI Provider ('groq' | 'gemini' | 'mock')
AI_PROVIDER="groq"

# Optional Fallback AI Provider ('gemini' | 'groq' | 'mock')
AI_FALLBACK_PROVIDER="gemini"

# Groq Configuration (Ultra-fast LLM inference)
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# Google Gemini Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-1.5-flash"

# Optional Inference Hyperparameters
LLM_TEMPERATURE="0.2"
LLM_MAX_TOKENS="4096"
LLM_TIMEOUT_MS="30000"

# Application Environment
NODE_ENV="development"
